{%- comment -%}
  AUREA Material Science Grid
  Educates customer on quality: Stone + Metal + Finish
  Premium gold SVG icons - no emojis
{%- endcomment -%}

<section class="aurea-material-grid">
  <div class="page-width">
    
    <div class="aurea-material-grid__header">
      <p class="aurea-material-grid__preheading">{{ section.settings.preheading }}</p>
      <h3 class="aurea-material-grid__heading">{{ section.settings.heading }}</h3>
    </div>
    
    <div class="aurea-material-grid__items">
      
      {% for block in section.blocks %}
        <div class="aurea-material-grid__item" {{ block.shopify_attributes }}>
          <div class="aurea-material-grid__icon-circle">
            {%- case block.settings.icon_type -%}
              {%- when 'diamond' -%}
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M6 3h12l4 6-10 13L2 9z"/>
                  <path d="M2 9h20"/>
                  <path d="M12 22l4-13M12 22l-4-13"/>
                  <path d="M10 3l2 6 2-6"/>
                </svg>
              {%- when 'chain' -%}
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
                  <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
                </svg>
              {%- when 'droplet' -%}
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/>
                </svg>
              {%- when 'shield' -%}
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                  <path d="M9 12l2 2 4-4"/>
                </svg>
              {%- when 'sparkle' -%}
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M12 3l1.5 5.5L19 10l-5.5 1.5L12 17l-1.5-5.5L5 10l5.5-1.5L12 3z"/>
                  <path d="M5 3l.5 2L7 5.5 5.5 6 5 8l-.5-2L3 5.5 4.5 5 5 3z"/>
                  <path d="M19 17l.5 2 1.5.5-1.5.5-.5 2-.5-2-1.5-.5 1.5-.5.5-2z"/>
                </svg>
              {%- when 'leaf' -%}
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/>
                  <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>
                </svg>
              {%- when 'heart' -%}
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                </svg>
              {%- when 'star' -%}
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                </svg>
              {%- else -%}
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <circle cx="12" cy="12" r="10"/>
                  <path d="M9 12l2 2 4-4"/>
                </svg>
            {%- endcase -%}
          </div>
          
          <h4 class="aurea-material-grid__title">{{ block.settings.title }}</h4>
          <p class="aurea-material-grid__desc">{{ block.settings.description }}</p>
        </div>
      {% endfor %}
      
    </div>
    
  </div>
</section>

<style>
  .aurea-material-grid {
    background: #FFFFFF;
    padding: 3rem 0;
    border-top: 1px solid #E8E4DF;
    border-bottom: 1px solid #E8E4DF;
    margin: 2rem 0;
  }
  
  .aurea-material-grid__header {
    text-align: center;
    margin-bottom: 2rem;
  }
  
  .aurea-material-grid__preheading {
    font-family: var(--font-body--family, 'Cormorant', Georgia, serif);
    font-size: 0.8rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #B8860B;
    margin-bottom: 0.5rem;
  }
  
  .aurea-material-grid__heading {
    font-family: var(--font-heading--family, 'Playfair Display', Georgia, serif);
    font-size: 1.5rem;
    font-weight: 400;
    margin: 0;
  }
  
  .aurea-material-grid__items {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    text-align: center;
  }
  
  .aurea-material-grid__item {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  
  .aurea-material-grid__icon-circle {
    width: 64px;
    height: 64px;
    margin-bottom: 1rem;
    border: 1px solid #E8E4DF;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #FAF8F5;
    color: #B8860B;
  }
  
  .aurea-material-grid__title {
    font-family: var(--font-body--family, 'Cormorant', Georgia, serif);
    font-weight: 600;
    font-size: 0.9rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
    color: #1A1A1A;
  }
  
  .aurea-material-grid__desc {
    font-family: var(--font-body--family, 'Cormorant', Georgia, serif);
    font-size: 0.85rem;
    line-height: 1.6;
    color: rgba(26, 26, 26, 0.7);
    margin: 0;
  }
  
  @media (max-width: 768px) {
    .aurea-material-grid__items {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>

{% schema %}
{
  "name": "Material Science",
  "settings": [
    {
      "type": "text",
      "id": "preheading",
      "label": "Preheading",
      "default": "Why It Lasts"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Science of Forever"
    }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Spec",
      "settings": [
        {
          "type": "select",
          "id": "icon_type",
          "label": "Icon",
          "options": [
            { "value": "diamond", "label": "Diamond / Stone" },
            { "value": "chain", "label": "Chain / Metal" },
            { "value": "droplet", "label": "Droplet / Waterproof" },
            { "value": "shield", "label": "Shield / Protection" },
            { "value": "sparkle", "label": "Sparkle / Shine" },
            { "value": "leaf", "label": "Leaf / Eco" },
            { "value": "heart", "label": "Heart" },
            { "value": "star", "label": "Star / Quality" }
          ],
          "default": "diamond"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "The Stone"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "AAAA Grade Cubic Zirconia (Diamond Simulant)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Material Science",
      "blocks": [
        {
          "type": "spec",
          "settings": {
            "icon_type": "diamond",
            "title": "The Stone",
            "description": "AAAA Grade Cubic Zirconia (Diamond Simulant)"
          }
        },
        {
          "type": "spec",
          "settings": {
            "icon_type": "chain",
            "title": "The Metal",
            "description": "316L Surgical Stainless Steel (Hypoallergenic)"
          }
        },
        {
          "type": "spec",
          "settings": {
            "icon_type": "droplet",
            "title": "The Finish",
            "description": "18k Real Gold PVD (Waterproof & Sweatproof)"
          }
        }
      ]
    }
  ]
}
{% endschema %}
