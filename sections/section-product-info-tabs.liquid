{%- comment -%}
  AUREA Product Info Tabs/Accordion
  
  Desktop: Horizontal tabs
  Mobile: Accordion (風琴式)
  
  Responsive design with smooth transitions
{%- endcomment -%}

{{ 'section-product-info-tabs.css' | asset_url | stylesheet_tag }}

<section class="product-info-tabs" style="
  --padding-top: {{ section.settings.padding_top }}px;
  --padding-bottom: {{ section.settings.padding_bottom }}px;
  --active-color: {{ section.settings.active_tab_color }};
">
  <div class="page-width">
    
    {%- comment -%} Desktop: Tab Navigation {%- endcomment -%}
    <div class="product-info-tabs__nav" role="tablist">
      {%- for block in section.blocks -%}
        <button 
          class="product-info-tabs__tab{% if forloop.first %} product-info-tabs__tab--active{% endif %}"
          role="tab"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          aria-controls="panel-{{ block.id }}"
          id="tab-{{ block.id }}"
          data-tab-index="{{ forloop.index0 }}"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.icon != 'none' and block.settings.icon != blank -%}
            <span class="product-info-tabs__icon">
              {%- case block.settings.icon -%}
                {%- when 'info' -%}
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
                {%- when 'truck' -%}
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                {%- when 'diamond' -%}
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 3h12l4 6-10 13L2 9z"/><path d="M2 9h20"/></svg>
                {%- when 'heart' -%}
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                {%- when 'gift' -%}
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="8" width="18" height="13" rx="2"/><path d="M12 8V21M3 12h18"/></svg>
                {%- when 'star' -%}
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                {%- when 'shield' -%}
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              {%- endcase -%}
            </span>
          {%- endif -%}
          <span class="product-info-tabs__tab-text">{{ block.settings.title }}</span>
        </button>
      {%- endfor -%}
    </div>
    
    {%- comment -%} Desktop: Tab Panels {%- endcomment -%}
    <div class="product-info-tabs__panels">
      {%- for block in section.blocks -%}
        <div 
          class="product-info-tabs__panel{% if forloop.first %} product-info-tabs__panel--active{% endif %}"
          role="tabpanel"
          id="panel-{{ block.id }}"
          aria-labelledby="tab-{{ block.id }}"
          data-panel-index="{{ forloop.index0 }}"
          {% unless forloop.first %}hidden{% endunless %}
        >
          {%- if block.settings.heading != blank -%}
            <h3 class="product-info-tabs__heading">{{ block.settings.heading }}</h3>
          {%- endif -%}
          
          <div class="product-info-tabs__content rte">
            {{ block.settings.content }}
          </div>
          
          {%- if block.settings.image != blank -%}
            <div class="product-info-tabs__image">
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy' }}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    
    {%- comment -%} Mobile: Accordion {%- endcomment -%}
    <div class="product-info-tabs__accordion">
      {%- for block in section.blocks -%}
        <details class="product-info-tabs__accordion-item"{% if forloop.first %} open{% endif %} {{ block.shopify_attributes }}>
          <summary class="product-info-tabs__accordion-header">
            <span class="product-info-tabs__accordion-icon">
              {%- case block.settings.icon -%}
                {%- when 'info' -%}
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
                {%- when 'truck' -%}
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                {%- when 'diamond' -%}
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 3h12l4 6-10 13L2 9z"/><path d="M2 9h20"/></svg>
                {%- when 'heart' -%}
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                {%- when 'gift' -%}
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="8" width="18" height="13" rx="2"/><path d="M12 8V21M3 12h18"/></svg>
                {%- when 'star' -%}
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                {%- when 'shield' -%}
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                {%- else -%}
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
              {%- endcase -%}
            </span>
            <span class="product-info-tabs__accordion-title">{{ block.settings.title }}</span>
            <span class="product-info-tabs__accordion-toggle">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5">
                <line x1="6" y1="2" x2="6" y2="10" class="product-info-tabs__accordion-plus-v"/>
                <line x1="2" y1="6" x2="10" y2="6"/>
              </svg>
            </span>
          </summary>
          
          <div class="product-info-tabs__accordion-content">
            {%- if block.settings.heading != blank -%}
              <h3 class="product-info-tabs__heading">{{ block.settings.heading }}</h3>
            {%- endif -%}
            
            <div class="product-info-tabs__content rte">
              {{ block.settings.content }}
            </div>
            
            {%- if block.settings.image != blank -%}
              <div class="product-info-tabs__image">
                {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy' }}
              </div>
            {%- endif -%}
          </div>
        </details>
      {%- endfor -%}
    </div>
    
  </div>
</section>

<script>
(function() {
  'use strict';
  
  function init() {
    const sections = document.querySelectorAll('.product-info-tabs:not([data-initialized])');
    
    sections.forEach(section => {
      section.setAttribute('data-initialized', 'true');
      
      const tabs = section.querySelectorAll('.product-info-tabs__tab');
      const panels = section.querySelectorAll('.product-info-tabs__panel');
      
      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          const index = parseInt(tab.dataset.tabIndex, 10);
          
          // Deactivate all tabs
          tabs.forEach(t => {
            t.classList.remove('product-info-tabs__tab--active');
            t.setAttribute('aria-selected', 'false');
          });
          
          // Hide all panels
          panels.forEach(p => {
            p.classList.remove('product-info-tabs__panel--active');
            p.hidden = true;
          });
          
          // Activate clicked tab
          tab.classList.add('product-info-tabs__tab--active');
          tab.setAttribute('aria-selected', 'true');
          
          // Show corresponding panel
          const panel = section.querySelector(`[data-panel-index="${index}"]`);
          if (panel) {
            panel.classList.add('product-info-tabs__panel--active');
            panel.hidden = false;
          }
        });
        
        // Keyboard navigation
        tab.addEventListener('keydown', (e) => {
          const index = parseInt(tab.dataset.tabIndex, 10);
          let newIndex = index;
          
          if (e.key === 'ArrowRight') {
            newIndex = (index + 1) % tabs.length;
          } else if (e.key === 'ArrowLeft') {
            newIndex = (index - 1 + tabs.length) % tabs.length;
          }
          
          if (newIndex !== index) {
            tabs[newIndex].focus();
            tabs[newIndex].click();
          }
        });
      });
    });
  }
  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
  
  document.addEventListener('shopify:section:load', init);
})();
</script>

{% schema %}
{
  "name": "Product Info Tabs",
  "tag": "section",
  "class": "section-product-info-tabs",
  "settings": [
    {
      "type": "select",
      "id": "tab_alignment",
      "label": "Tab Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "stretch", "label": "Stretch" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "active_tab_color",
      "label": "Active Tab Color",
      "default": "#B8860B"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Tab Title",
          "default": "Tab Title"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Content Heading",
          "default": "Heading"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "info", "label": "Info" },
            { "value": "truck", "label": "Delivery" },
            { "value": "diamond", "label": "Quality" },
            { "value": "heart", "label": "Care" },
            { "value": "gift", "label": "Gift" },
            { "value": "star", "label": "Star" },
            { "value": "shield", "label": "Shield" }
          ],
          "default": "info"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Tab content goes here.</p>"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Info Tabs",
      "blocks": [
        {
          "type": "tab",
          "settings": {
            "title": "DETAILS & SPECIFICATIONS",
            "heading": "The Finer Details",
            "icon": "info",
            "content": "<p>Crafted for the modern minimalist. Every Aurea piece is designed to combine timeless elegance with everyday durability.</p><p><strong>Material:</strong> 18K Gold Plated on Premium Stainless Steel (PVD Coated).</p><p><strong>Durability:</strong> 100% Tarnish-Free. Water, Sweat, and Heat Resistant.</p><p><strong>Hypoallergenic:</strong> No nickel, no lead. Safe for sensitive skin.</p>"
          }
        },
        {
          "type": "tab",
          "settings": {
            "title": "DELIVERY & RETURNS",
            "heading": "Shipping & Pre-order",
            "icon": "truck",
            "content": "<p>As an independent studio, we operate in small batches to ensure the highest quality and minimize waste.</p><p><strong>Processing Time:</strong> Due to high demand, please allow 7-12 working days for your order to be prepared and dispatched.</p><p><strong>UK Delivery:</strong> Sent via Royal Mail (Tracked). Arrives in 2-3 days after dispatch.</p><p><strong>Returns:</strong> We offer a 14-day return window for unworn items.</p>"
          }
        },
