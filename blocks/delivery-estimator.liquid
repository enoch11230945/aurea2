{%- comment -%}
  AUREA Delivery Estimator Block
  
  Shows dynamic delivery date based on current time and cut-off.
  Critical for PRD requirement: "Order by 2pm for same-day dispatch"
  
  Calculates delivery window: 2-3 business days from dispatch.
{%- endcomment -%}

{%- liquid
  assign block_settings = block.settings
-%}

<div 
  class="aurea-delivery-estimator spacing-style" 
  style="{% render 'spacing-style', settings: block_settings %}"
  {{ block.shopify_attributes }}
  data-delivery-estimator
  data-cutoff-hour="{{ block_settings.cutoff_hour }}"
  data-min-days="{{ block_settings.min_delivery_days }}"
  data-max-days="{{ block_settings.max_delivery_days }}"
>
  <div class="aurea-delivery-estimator__container">
    <span class="aurea-delivery-estimator__icon" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="1" y="3" width="15" height="13" rx="2"/>
        <polyline points="16 8 20 8 23 11 23 16 16 16 16 8"/>
        <circle cx="5.5" cy="18.5" r="2.5"/>
        <circle cx="18.5" cy="18.5" r="2.5"/>
      </svg>
    </span>
    
    <div class="aurea-delivery-estimator__text">
      <span class="aurea-delivery-estimator__label">{{ block_settings.label_text }}</span>
      <strong class="aurea-delivery-estimator__date" data-delivery-date>
        {%- comment -%} Fallback for non-JS: show static text {%- endcomment -%}
        {{ block_settings.fallback_text }}
      </strong>
    </div>
  </div>
  
  {%- if block_settings.show_cutoff -%}
    <div class="aurea-delivery-estimator__cutoff" data-cutoff-message>
      {%- comment -%} JS will populate this with dynamic countdown {%- endcomment -%}
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .aurea-delivery-estimator {
    width: 100%;
  }
  
  .aurea-delivery-estimator__container {
    display: flex;
    align-items: flex-start;
    gap: var(--gap-sm, 10px);
    padding: var(--padding-sm, 12px);
    background: var(--color-background-secondary, #FAF8F5);
    border: 1px solid var(--color-border, #E8E4DF);
    border-radius: var(--style-border-radius-inputs, 8px);
  }
  
  .aurea-delivery-estimator__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-accent, #B8860B);
    flex-shrink: 0;
    margin-top: 2px;
  }
  
  .aurea-delivery-estimator__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: var(--font-paragraph--size, 0.9rem);
  }
  
  .aurea-delivery-estimator__label {
    color: var(--color-foreground-subdued, rgba(26, 26, 26, 0.7));
    font-size: var(--font-paragraph-small--size, 0.8rem);
  }
  
  .aurea-delivery-estimator__date {
    color: var(--color-foreground, #1A1A1A);
    font-weight: 600;
  }
  
  .aurea-delivery-estimator__cutoff {
    margin-top: var(--margin-xs, 8px);
    padding: var(--padding-xs, 8px) var(--padding-sm, 12px);
    background: rgba(184, 134, 11, 0.08);
    border-radius: var(--style-border-radius-inputs, 8px);
    font-size: var(--font-paragraph-small--size, 0.8rem);
    color: var(--color-accent, #B8860B);
    font-weight: 500;
  }
  
  .aurea-delivery-estimator__cutoff:empty {
    display: none;
  }
{% endstylesheet %}

<script>
(function() {
  'use strict';
  
  function init() {
    const estimators = document.querySelectorAll('[data-delivery-estimator]:not([data-initialized])');
    
    estimators.forEach(estimator => {
      estimator.setAttribute('data-initialized', 'true');
      
      const cutoffHour = parseInt(estimator.dataset.cutoffHour, 10) || 14;
      const minDays = parseInt(estimator.dataset.minDays, 10) || 2;
      const maxDays = parseInt(estimator.dataset.maxDays, 10) || 3;
      
      const dateEl = estimator.querySelector('[data-delivery-date]');
      const cutoffEl = estimator.querySelector('[data-cutoff-message]');
      
      function addBusinessDays(date, days) {
        const result = new Date(date);
        let added = 0;
        
        while (added < days) {
          result.setDate(result.getDate() + 1);
          const dayOfWeek = result.getDay();
          // Skip Saturday (6) and Sunday (0)
          if (dayOfWeek !== 0 && dayOfWeek !== 6) {
            added++;
          }
        }
        
        return result;
      }
      
      function formatDate(date) {
        const options = { weekday: 'long', day: 'numeric', month: 'short' };
        return date.toLocaleDateString('en-GB', options);
      }
      
      function update() {
        const now = new Date();
        const ukOffset = 0; // UTC for UK (adjust for BST if needed)
        const ukNow = new Date(now.getTime() + (ukOffset * 60 * 60 * 1000));
        
        const currentHour = ukNow.getHours();
        const currentMinutes = ukNow.getMinutes();
        const dayOfWeek = ukNow.getDay();
        
        // Determine dispatch date
        let dispatchDate = new Date(ukNow);
        
        // If after cutoff OR weekend, dispatch tomorrow (or Monday)
        if (currentHour >= cutoffHour || dayOfWeek === 0 || dayOfWeek === 6) {
          dispatchDate.setDate(dispatchDate.getDate() + 1);
          // Skip to Monday if Saturday/Sunday
          while (dispatchDate.getDay() === 0 || dispatchDate.getDay() === 6) {
            dispatchDate.setDate(dispatchDate.getDate() + 1);
          }
        }
        
        // Calculate delivery window
        const minDeliveryDate = addBusinessDays(dispatchDate, minDays);
        const maxDeliveryDate = addBusinessDays(dispatchDate, maxDays);
        
        // Update date display
        if (dateEl) {
          if (minDays === maxDays) {
            dateEl.textContent = formatDate(minDeliveryDate);
          } else {
            dateEl.textContent = formatDate(minDeliveryDate) + ' - ' + formatDate(maxDeliveryDate);
          }
        }
        
        // Update cutoff message
        if (cutoffEl) {
          if (dayOfWeek > 0 && dayOfWeek < 6 && currentHour < cutoffHour) {
            const hoursLeft = cutoffHour - currentHour - 1;
            const minutesLeft = 60 - currentMinutes;
            
            if (hoursLeft > 0) {
              cutoffEl.textContent = `⏰ Order within ${hoursLeft}h ${minutesLeft}m for same-day dispatch`;
            } else if (minutesLeft > 0) {
              cutoffEl.textContent = `⏰ Order within ${minutesLeft} minutes for same-day dispatch`;
            } else {
              cutoffEl.textContent = '';
            }
          } else {
            cutoffEl.textContent = '';
          }
        }
      }
      
      // Initial update
      update();
      
      // Update every minute
      setInterval(update, 60000);
    });
  }
  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
  
  // Re-init on Shopify section load
  document.addEventListener('shopify:section:load', init);
})();
</script>

{% schema %}
{
  "name": "Delivery Estimator",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label_text",
      "label": "Label Text",
      "default": "Order now to receive by"
    },
    {
      "type": "text",
      "id": "fallback_text",
      "label": "Fallback Text (No JS)",
      "default": "2-3 Business Days"
    },
    {
      "type": "range",
      "id": "cutoff_hour",
      "label": "Same-Day Dispatch Cutoff (Hour)",
      "min": 10,
      "max": 18,
      "step": 1,
      "default": 14,
      "info": "Orders before this hour (UK time) dispatch same day. Default: 2pm"
    },
    {
      "type": "range",
      "id": "min_delivery_days",
      "label": "Minimum Delivery Days",
      "min": 1,
      "max": 7,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "max_delivery_days",
      "label": "Maximum Delivery Days",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_cutoff",
      "label": "Show Cutoff Countdown",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Delivery Estimator",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
