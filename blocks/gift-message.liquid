{%- comment -%}
  AUREA Gift Message Block
  
  Uses Line Item Properties (not Cart Notes) to bind message to specific line item.
  This is critical for "one order, multiple gifts" scenario per PRD v2.0.
  
  The form attribute binds to the product form for proper submission.
{%- endcomment -%}

{%- liquid
  assign block_settings = block.settings
  assign product_form_id = 'product-form-' | append: section.id
-%}

<div 
  class="aurea-gift-message spacing-style" 
  style="{% render 'spacing-style', settings: block_settings %}"
  {{ block.shopify_attributes }}
  data-gift-message-block
>
  <details class="aurea-gift-message__details">
    <summary class="aurea-gift-message__summary" aria-expanded="false" role="button">
      <span class="aurea-gift-message__icon" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="3" y="8" width="18" height="13" rx="2"/>
          <path d="M12 8V21"/>
          <path d="M3 12H21"/>
          <path d="M12 2C10 2 9 4 8 5C7 6 4 8 4 8"/>
          <path d="M12 2C14 2 15 4 16 5C17 6 20 8 20 8"/>
        </svg>
      </span>
      <span class="aurea-gift-message__label">{{ block_settings.button_text }}</span>
      <span class="aurea-gift-message__toggle" aria-hidden="true">
        <svg class="aurea-gift-message__toggle-icon" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5">
          <line x1="6" y1="2" x2="6" y2="10" class="aurea-gift-message__toggle-vertical"/>
          <line x1="2" y1="6" x2="10" y2="6"/>
        </svg>
      </span>
    </summary>
    
    <div class="aurea-gift-message__content">
      {%- comment -%} Hidden checkbox to mark this as a gift {%- endcomment -%}
      <input 
        type="hidden" 
        name="properties[_Is Gift]" 
        value="Yes"
        form="{{ product_form_id }}"
        disabled
        data-gift-flag
      >
      
      <label for="gift-message-{{ section.id }}" class="visually-hidden">
        Gift Message
      </label>
      
      <textarea 
        id="gift-message-{{ section.id }}"
        name="properties[Gift Message]"
        class="aurea-gift-message__textarea"
        placeholder="{{ block_settings.placeholder }}"
        maxlength="{{ block_settings.max_length }}"
        aria-label="Gift message for this item"
        form="{{ product_form_id }}"
        disabled
        data-gift-textarea
      ></textarea>
      
      <div class="aurea-gift-message__footer">
        <span class="aurea-gift-message__hint">
          {{ block_settings.hint_text }}
        </span>
        <span class="aurea-gift-message__counter" data-char-counter>
          <span data-char-count>0</span>/{{ block_settings.max_length }}
        </span>
      </div>
    </div>
  </details>
</div>

{% stylesheet %}
  .aurea-gift-message {
    width: 100%;
  }
  
  .aurea-gift-message__details {
    border: 1px dashed var(--color-border, rgba(0, 0, 0, 0.15));
    border-radius: var(--style-border-radius-inputs, 8px);
    background: linear-gradient(135deg, rgba(184, 134, 11, 0.03) 0%, rgba(184, 134, 11, 0.01) 100%);
    overflow: hidden;
  }
  
  .aurea-gift-message__summary {
    display: flex;
    align-items: center;
    gap: var(--gap-sm, 8px);
    padding: var(--padding-md, 16px);
    cursor: pointer;
    list-style: none;
    font-size: var(--font-paragraph--size, 0.9rem);
    font-weight: 500;
    color: var(--color-foreground, #1A1A1A);
    transition: background 0.2s ease;
  }
  
  .aurea-gift-message__summary:hover {
    background: rgba(184, 134, 11, 0.03);
  }
  
  .aurea-gift-message__summary::-webkit-details-marker {
    display: none;
  }
  
  .aurea-gift-message__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-accent, #B8860B);
  }
  
  .aurea-gift-message__label {
    flex: 1;
  }
  
  .aurea-gift-message__toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-accent, #B8860B);
  }
  
  .aurea-gift-message__toggle-vertical {
    transition: transform 0.2s ease, opacity 0.2s ease;
    transform-origin: center;
  }
  
  .aurea-gift-message__details[open] .aurea-gift-message__toggle-vertical {
    transform: rotate(90deg);
    opacity: 0;
  }
  
  .aurea-gift-message__content {
    padding: 0 var(--padding-md, 16px) var(--padding-md, 16px);
  }
  
  .aurea-gift-message__textarea {
    width: 100%;
    min-height: 100px;
    padding: var(--padding-sm, 12px);
    border: 1px solid var(--color-border, rgba(0, 0, 0, 0.1));
    border-radius: var(--style-border-radius-inputs, 6px);
    font-family: inherit;
    font-size: var(--font-paragraph--size, 0.9rem);
    line-height: 1.5;
    resize: vertical;
    background: var(--color-background, #fff);
    color: var(--color-foreground, #1A1A1A);
  }
  
  .aurea-gift-message__textarea::placeholder {
    color: var(--color-foreground-subdued, rgba(26, 26, 26, 0.5));
  }
  
  .aurea-gift-message__textarea:focus {
    outline: none;
    border-color: var(--color-accent, #B8860B);
    box-shadow: 0 0 0 2px rgba(184, 134, 11, 0.1);
  }
  
  .aurea-gift-message__footer {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-top: var(--margin-xs, 8px);
    font-size: var(--font-paragraph-small--size, 0.75rem);
    gap: var(--gap-sm, 8px);
  }
  
  .aurea-gift-message__hint {
    color: var(--color-foreground-subdued, rgba(26, 26, 26, 0.6));
    font-style: italic;
    flex: 1;
  }
  
  .aurea-gift-message__counter {
    color: var(--color-foreground-subdued, rgba(26, 26, 26, 0.5));
    white-space: nowrap;
  }
{% endstylesheet %}

<script>
(function() {
  'use strict';
  
  // Initialize on DOM ready or immediately if already loaded
  function init() {
    const blocks = document.querySelectorAll('[data-gift-message-block]:not([data-initialized])');
    
    blocks.forEach(block => {
      block.setAttribute('data-initialized', 'true');
      
      const details = block.querySelector('details');
      const textarea = block.querySelector('[data-gift-textarea]');
      const giftFlag = block.querySelector('[data-gift-flag]');
      const charCount = block.querySelector('[data-char-count]');
      const summary = block.querySelector('summary');
      
      if (!details || !textarea || !giftFlag) return;
      
      // Enable/disable form fields based on details open state
      details.addEventListener('toggle', function() {
        const isOpen = details.open;
        
        // Enable inputs only when section is open
        textarea.disabled = !isOpen;
        giftFlag.disabled = !isOpen;
        
        // Update aria-expanded
        if (summary) {
          summary.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        }
        
        // Focus textarea when opened
        if (isOpen && textarea) {
          setTimeout(() => textarea.focus(), 100);
        }
      });
      
      // Character counter
      if (textarea && charCount) {
        textarea.addEventListener('input', function() {
          charCount.textContent = textarea.value.length;
        });
      }
    });
  }
  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
  
  // Re-init on Shopify section load (for theme editor)
  document.addEventListener('shopify:section:load', init);
})();
</script>

{% schema %}
{
  "name": "Gift Message",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Add a Free Gift Message"
    },
    {
      "type": "textarea",
      "id": "placeholder",
      "label": "Placeholder Text",
      "default": "Write your heartfelt message here...\n\ne.g., 'To my love, you mean everything to me...'"
    },
    {
      "type": "text",
      "id": "hint_text",
      "label": "Hint Text",
      "default": "We'll hand-write this on a premium card and place it inside the box."
    },
    {
      "type": "range",
      "id": "max_length",
      "label": "Maximum Characters",
      "min": 50,
      "max": 500,
      "step": 10,
      "default": 200
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Gift Message",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
